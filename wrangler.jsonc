{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-11-17",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "prefill-learn",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// Served at learn.prefill.here. The prefill.here zone must be on the same
	// Cloudflare account that `wrangler whoami` shows. Cloudflare creates the
	// DNS record and certificate on the first deploy.
	"routes": [{ "pattern": "learn.prefill.here", "custom_domain": true }],
	// Only the custom domain serves the site, not *.workers.dev.
	"workers_dev": false,
	"preview_urls": false,
	"observability": {
		"enabled": true
	}
}
