---
// Algebrica-style numbered index: "1. Chapter" with "1.1 Entry ... KIND" rows.
// Chapters collapse; on entry pages only the current chapter is shown.
import PixelIcon from './PixelIcon.astro';
import { getIndex, KIND_LABEL } from '../lib/graph';

interface Props {
  /** Highlight this entry and show only its chapter. */
  current?: string;
}
const { current } = Astro.props;
const all = await getIndex();
const chapters = current ? all.filter((c) => c.items.some((i) => i.id === current)) : all;
---

<div class="tindex">
  {chapters.length === 0 && (
    <p class="empty nf-pixel-inset">Nothing here yet.</p>
  )}
  {chapters.map((c) => (
    <details class="chapter" open>
      <summary class="chapter__head">
        <span class="chapter__num">{c.number}.</span>
        <span class="chapter__title">{c.title}</span>
        <span class="chapter__toggle nf-pixel-flat" aria-hidden="true">
          <PixelIcon name="minus" size={1} class="when-open" />
          <PixelIcon name="plus" size={1} class="when-closed" />
        </span>
      </summary>
      <ol class="rows">
        {c.items.map((n) => (
          <li>
            <a href={n.url} data-preview={n.id} class:list={['row', { 'row--current': n.id === current }]} aria-current={n.id === current ? 'page' : undefined}>
              <span class="row__num">{n.number}</span>
              <span class="row__title">{n.title}</span>
              <span class="row__kind nf-label">{KIND_LABEL[n.kind]}</span>
            </a>
          </li>
        ))}
      </ol>
    </details>
  ))}
</div>

<style>
  .empty {
    margin: 1.5rem 0 0;
    padding: 1.25rem;
    text-align: center;
    font-size: 0.875rem;
    color: var(--nf-fg-muted);
    background: var(--nf-surface);
  }
  .chapter { padding: 1.5rem 0 1.25rem; border-bottom: var(--nf-px) solid var(--nf-border); }
  .chapter:last-child { border-bottom: 0; }
  .chapter__head {
    list-style: none;
    display: grid;
    grid-template-columns: 2.25rem 1fr auto;
    align-items: center;
    cursor: pointer;
    font-weight: 650;
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
    margin-bottom: 0.4rem;
  }
  .chapter__head::-webkit-details-marker { display: none; }
  .chapter__num { color: var(--nf-fg-muted); }
  .chapter__toggle { width: 14px; height: 14px; display: grid; place-items: center; --nf-px: 1px; }
  :global(.chapter:not([open]) .when-open), :global(.chapter[open] .when-closed) { display: none; }
  .chapter:not([open]) .chapter__head { margin-bottom: 0; }
  .rows { list-style: none; padding: 0; margin: 0; }
  .row {
    display: grid;
    grid-template-columns: 2.25rem 1fr auto;
    align-items: baseline;
    gap: 0 0.5rem;
    padding: 0.4rem 0.5rem;
    margin: 0 -0.5rem;
    text-decoration: none;
    font-size: 0.9rem;
  }
  .row__num { font-size: 0.75rem; color: var(--nf-fg-subtle); font-variant-numeric: tabular-nums; }
  .row__kind { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.625rem; }
  .row:hover { background: var(--nf-surface-2); }
  .row:hover .row__title { background: var(--nf-sun); color: var(--nf-sun-fg); }
  .row--current { background: var(--nf-accent); color: var(--nf-accent-fg); }
  .row--current .row__num, .row--current .row__kind { color: var(--nf-accent-fg); opacity: 0.7; }
  .row--current:hover { background: var(--nf-accent); }
  .row--current:hover .row__title { background: none; color: inherit; }
</style>
