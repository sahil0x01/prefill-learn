---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource-variable/eb-garamond';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { getCollection } from 'astro:content';
import PixelIcon from '../components/PixelIcon.astro';
import { KINDS } from '../lib/graph';
import { KIND_SPRITE } from '../lib/sprites';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
}
const {
  title,
  description = "What we're learning about building with AI, mostly how to run models fast and cheap. By Prefill.",
  wide = false,
} = Astro.props;
const fullTitle = title ? `${title} | Prefill Learn` : 'Prefill Learn';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ORG_URL = 'https://prefill.here';
const REPO_URL = 'https://github.com/sahil0x01/prefill-learn';
const browse = [
  ['/notes/', 'Notes', 'note'],
  ['/widgets/', 'Widgets', 'widget'],
  ['/projects/', 'Projects', 'project'],
  ['/paths/', 'Paths', 'path'],
  ['/graph/', 'The Graph', 'graph'],
] as const;
const paths = await getCollection('paths');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="Prefill Learn" />
    <meta property="og:title" content={title ?? 'Prefill Learn'} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={title ? 'article' : 'website'} />
    <script is:inline>
      try {
        const t = localStorage.getItem('prefill:theme');
        if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches))
          document.documentElement.classList.add('dark');
      } catch {}
    </script>
  </head>
  <body>
    <header class="topbar">
      <button class="topbar__btn" id="menu-open" aria-label="Open menu" aria-controls="drawer" aria-expanded="false">
        <PixelIcon name="menu" size={2} />
      </button>
      <a href="/" class="wordmark" aria-label="Prefill Learn home">prefill<span class="wordmark__sub">/learn</span><span class="nf-cursor" aria-hidden="true"></span></a>
      <button class="topbar__btn" id="theme" aria-label="Toggle dark mode">
        <PixelIcon name="moon" size={2} class="only-light" />
        <PixelIcon name="sun" size={2} class="only-dark" />
      </button>
    </header>

    <div class="scrim" id="scrim" hidden></div>
    <aside class="drawer" id="drawer" aria-label="Site menu" hidden>
      <div class="drawer__head">
        <span class="nf-label">Menu</span>
        <button class="topbar__btn" id="menu-close" aria-label="Close menu"><PixelIcon name="cross" size={2} /></button>
      </div>
      <nav class="drawer__section">
        {browse.map(([href, label, icon]) => (
          <a href={href} class="drawer__link" aria-current={Astro.url.pathname.startsWith(href) ? 'page' : undefined}>
            <PixelIcon name={icon} size={2} />
            {label}
          </a>
        ))}
      </nav>
      {paths.length > 0 && (
        <div class="drawer__section">
          <span class="nf-label">Paths</span>
          {paths.map((p) => (
            <a href={`/paths/${p.id}/`} class="drawer__link drawer__link--small">{p.data.title}</a>
          ))}
        </div>
      )}
      <div class="drawer__section">
        <span class="nf-label">Your history</span>
        <ol class="history" id="history"></ol>
        <p class="history__empty muted" id="history-empty">Your recent pages will appear here. Start browsing.</p>
      </div>
      <div class="drawer__section">
        <a href={REPO_URL} class="drawer__link drawer__link--small">GitHub repository</a>
      </div>
      <p class="drawer__foot muted">
        Made by <a class="link" href={ORG_URL}>Prefill</a>. Open source on <a class="link" href={REPO_URL}>GitHub</a>.
      </p>
    </aside>

    <main class:list={['wrap', { 'wrap--wide': wide }]}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <hr class="rule" />
        <nav class="site-footer__links">
          {browse.map(([href, label]) => <a href={href}>{label}</a>)}
          <a href={REPO_URL}>GitHub</a>
          <a href={ORG_URL}>prefill.here</a>
        </nav>
        <p class="muted">
          Made by <a class="link" href={ORG_URL}>Prefill</a>. Open source on <a class="link" href={REPO_URL}>GitHub</a>,
          so if you spot a mistake you can fix it.
        </p>
        <p class="muted license">
          Writing is <a class="link" href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>, code is
          <a class="link" href={`${REPO_URL}/blob/main/LICENSE`}>MIT</a>. Reuse anything, just credit Prefill.
        </p>
      </div>
    </footer>

    <div id="preview" class="nf-pixel" role="tooltip"></div>
    {KINDS.map((k) => (
      <template id={`ico-${k}`}><PixelIcon name={KIND_SPRITE[k]} size={1} /></template>
    ))}

    <script>
      // Theme toggle (nullfuse: `dark` class on <html>).
      document.getElementById('theme')!.addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('dark');
        try { localStorage.setItem('prefill:theme', dark ? 'dark' : 'light'); } catch {}
      });

      // Drawer.
      const drawer = document.getElementById('drawer')!;
      const scrim = document.getElementById('scrim')!;
      const openBtn = document.getElementById('menu-open')!;
      const setOpen = (open: boolean) => {
        drawer.hidden = !open;
        scrim.hidden = !open;
        openBtn.setAttribute('aria-expanded', String(open));
        if (open) (drawer.querySelector('a, button') as HTMLElement | null)?.focus();
      };
      openBtn.addEventListener('click', () => setOpen(true));
      document.getElementById('menu-close')!.addEventListener('click', () => setOpen(false));
      scrim.addEventListener('click', () => setOpen(false));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !drawer.hidden) setOpen(false); });

      // Visited pages (for path progress) and recent history (for the drawer).
      try {
        const here = location.pathname;
        const visited = new Set<string>(JSON.parse(localStorage.getItem('prefill:visited') ?? '[]'));
        const isEntry = /^\/(notes|widgets|projects)\/[^/]+\/$/.test(here);
        if (isEntry) {
          visited.add(here);
          localStorage.setItem('prefill:visited', JSON.stringify([...visited]));
          const t = document.querySelector('h1')?.textContent?.trim() ?? here;
          const hist: { u: string; t: string }[] = JSON.parse(localStorage.getItem('prefill:history') ?? '[]');
          const next = [{ u: here, t }, ...hist.filter((h) => h.u !== here)].slice(0, 8);
          localStorage.setItem('prefill:history', JSON.stringify(next));
        }
        const list = document.getElementById('history')!;
        const hist: { u: string; t: string }[] = JSON.parse(localStorage.getItem('prefill:history') ?? '[]');
        for (const h of hist) {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = h.u;
          a.textContent = h.t;
          li.appendChild(a);
          list.appendChild(li);
        }
        if (hist.length) document.getElementById('history-empty')!.hidden = true;
      } catch {}

      // Hover previews for wiki links and index rows.
      type Preview = { title: string; summary: string; kind: string };
      let data: Promise<Record<string, Preview>> | undefined;
      const box = document.getElementById('preview')!;
      const label: Record<string, string> = { notes: 'Note', widgets: 'Widget', projects: 'Project' };
      document.addEventListener('mouseover', async (e) => {
        const a = (e.target as Element).closest<HTMLAnchorElement>('a.wikilink, a[data-preview]');
        if (!a) return;
        data ??= fetch('/previews.json').then((r) => r.json());
        const p = (await data)[a.dataset.id ?? a.dataset.preview ?? ''];
        if (!p) return;
        box.textContent = '';
        const k = document.createElement('span');
        k.className = 'nf-label';
        const ico = document.getElementById(`ico-${p.kind}`) as HTMLTemplateElement | null;
        if (ico) k.appendChild(ico.content.cloneNode(true));
        k.appendChild(document.createTextNode(label[p.kind] ?? p.kind));
        const t = document.createElement('strong');
        t.textContent = p.title;
        const s = document.createElement('span');
        s.className = 'sum';
        s.textContent = p.summary;
        for (const el of [k, t, s]) box.appendChild(el);
        const r = a.getBoundingClientRect();
        const maxLeft = scrollX + document.documentElement.clientWidth - box.offsetWidth - 16;
        box.style.left = `${Math.max(16, Math.min(r.left + scrollX, maxLeft))}px`;
        box.style.top = `${r.bottom + scrollY + 10}px`;
        box.classList.remove('is-on');
        void box.offsetWidth;
        box.classList.add('is-on');
      });
      document.addEventListener('mouseout', (e) => {
        if ((e.target as Element).closest('a.wikilink, a[data-preview]')) box.classList.remove('is-on');
      });
    </script>
  </body>
</html>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 30;
    height: var(--header-h);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0 var(--gutter);
    background: var(--nf-bg);
    border-bottom: var(--nf-px) solid var(--nf-border);
  }
  .topbar__btn {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    color: var(--nf-fg);
  }
  .topbar__btn:hover { background: var(--nf-surface-2); }
  #theme { justify-self: end; }
  .wordmark {
    font-family: var(--font-label);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 2px;
  }
  .wordmark__sub { color: var(--nf-fg-subtle); font-weight: 450; }
  .wordmark .nf-cursor { width: 0.5em; height: 0.95em; vertical-align: baseline; }
  /* :global because the class lands on the PixelIcon child component's <svg> */
  :global(.dark .only-light), :global(html:not(.dark) .only-dark) { display: none; }

  .scrim { position: fixed; inset: 0; z-index: 40; background: var(--nf-bg); opacity: 0.7; }
  .drawer {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 45;
    width: min(320px, 88vw);
    overflow-y: auto;
    background: var(--nf-bg);
    border-right: var(--nf-px) solid var(--nf-ink);
    padding: 0 var(--gutter) 2rem;
    animation: drawer-in var(--nf-dur-base) steps(4, end) both;
  }
  @keyframes drawer-in { from { transform: translateX(-100%); } to { transform: none; } }
  .drawer__head {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: var(--nf-px) solid var(--nf-border);
    margin: 0 calc(var(--gutter) * -1);
    padding: 0 var(--gutter);
  }
  .drawer__section {
    display: grid;
    gap: 0.15rem;
    padding: 1.25rem 0;
    border-bottom: var(--nf-px) solid var(--nf-border);
  }
  .drawer__section > .nf-label { margin-bottom: 0.6rem; }
  .drawer__link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.45rem 0.5rem;
    margin: 0 -0.5rem;
    text-decoration: none;
    font-weight: 550;
  }
  .drawer__link--small { font-weight: 450; font-size: 0.875rem; color: var(--nf-fg-muted); }
  .drawer__link:hover { background: var(--nf-surface-2); color: var(--nf-fg); }
  .drawer__link[aria-current='page'] { background: var(--nf-accent); color: var(--nf-accent-fg); }
  .history { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.1rem; }
  .history :global(a) {
    display: block;
    padding: 0.35rem 0.5rem;
    margin: 0 -0.5rem;
    font-size: 0.875rem;
    text-decoration: none;
    color: var(--nf-fg-muted);
  }
  .history :global(a:hover) { background: var(--nf-surface-2); color: var(--nf-fg); }
  .history__empty { font-size: 0.8125rem; margin: 0; }
  .drawer__foot { font-size: 0.8125rem; margin: 1.25rem 0 0; }

  main { padding-top: 3.5rem; }
  .site-footer { margin-top: 6rem; padding-bottom: 3rem; font-size: 0.8125rem; }
  .site-footer .license { margin-top: 0.4rem; font-size: 0.75rem; }
  .site-footer__links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; margin-bottom: 0.75rem; }
  .site-footer__links a { text-decoration: none; font-weight: 550; }
  .site-footer__links a:hover { background: var(--nf-sun); color: var(--nf-sun-fg); }
</style>
